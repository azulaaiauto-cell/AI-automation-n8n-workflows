    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a real estate lead qualification expert. Analyze the lead data and score them 1-10 based on:\n- Budget alignment (higher budget = higher score)\n- Timeline urgency (sooner = higher score)\n- Property interest specificity (specific needs = higher score)\n- Contact completeness (all fields filled = bonus points)\n\nQualification tiers:\n- Hot (8-10): Strong budget, urgent timeline, specific needs\n- Warm (5-7): Moderate budget, flexible timeline, general interest\n- Cold (1-4): Low budget, distant timeline, vague interest\n\nProvide a personalized message recommendation for each lead."
        }
      },
      "id": "3fb978f3-375e-4f30-8c9c-ea471783513b",
      "name": "AI Agent: Qualify Lead",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        704,
        496
      ]
    },
    {
      "parameters": {},
      "id": "291e2fc3-ec3d-49f2-a83c-6c21105af14d",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        712,
        720
      ]
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"score\": {\n      \"type\": \"integer\",\n      \"description\": \"Lead qualification score from 1-10\"\n    },\n    \"qualification\": {\n      \"type\": \"string\",\n      \"enum\": [\"hot\", \"warm\", \"cold\"],\n      \"description\": \"Lead temperature category\"\n    },\n    \"reasoning\": {\n      \"type\": \"string\",\n      \"description\": \"Brief explanation of why this score was assigned\"\n    },\n    \"next_action\": {\n      \"type\": \"string\",\n      \"enum\": [\"book_call\", \"nurture\", \"disqualify\"],\n      \"description\": \"Recommended next step\"\n    },\n    \"recommended_message\": {\n      \"type\": \"string\",\n      \"description\": \"Personalized message text for this lead\"\n    }\n  },\n  \"required\": [\"score\", \"qualification\", \"reasoning\", \"next_action\", \"recommended_message\"]\n}"
      },
      "id": "1066b803-caad-4fdd-aa6f-13b53ba30a35",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        840,
        720
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.output.score }}",
                    "rightValue": 8,
                    "operator": {
                      "type": "number",
                      "operation": "gte"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Hot Lead (8-10)"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.output.score }}",
                    "rightValue": 5,
                    "operator": {
                      "type": "number",
                      "operation": "gte"
                    }
                  },
                  {
                    "leftValue": "={{ $json.output.score }}",
                    "rightValue": 8,
                    "operator": {
                      "type": "number",
                      "operation": "lt"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Warm Lead (5-7)"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.output.score }}",
                    "rightValue": 5,
                    "operator": {
                      "type": "number",
                      "operation": "lt"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Cold Lead (<5)"
            }
          ]
        }
      },
